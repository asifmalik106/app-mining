# Copy to .env to override config/models.json. Never commit .env.

# Phase 1 marketplace collection. Presigned catalog downloads must not receive
# this Authorization header; use credentials only with api.atlassian.com.
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=replace_me
MARKETMINER_DB=./data/marketminer.sqlite3
MARKETMINER_DOWNLOAD_DIR=./data/downloads
MARKETMINER_REQUEST_DELAY_SECONDS=0.35
MARKETMINER_HTTP_TIMEOUT_SECONDS=60

# Local research models
PRIMARY_PROVIDER=ollama
PRIMARY_MODEL=qwen3.5:4b
PRIMARY_BASE_URL=http://127.0.0.1:11434
VERIFIER_PROVIDER=ollama
VERIFIER_MODEL=gemma3:4b
VERIFIER_BASE_URL=http://127.0.0.1:11434
ADJUDICATOR_PROVIDER=ollama
ADJUDICATOR_MODEL=qwen3.5:9b
ADJUDICATOR_BASE_URL=http://127.0.0.1:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT_SECONDS=180
