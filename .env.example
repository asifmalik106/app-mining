# Marketplace REST API V3 uses Basic Auth on api.atlassian.com only.
# Presigned S3 catalog downloads must not receive this Authorization header.
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=replace_me

# Local paths
MARKETMINER_DB=./data/marketminer.sqlite3
MARKETMINER_DOWNLOAD_DIR=./data/downloads

# Polite defaults. Increase only if Atlassian's API allows it for your account.
MARKETMINER_REQUEST_DELAY_SECONDS=0.35
MARKETMINER_HTTP_TIMEOUT_SECONDS=60

# Phase 2: local review extraction. Choose an installed Ollama model yourself.
AI_PROVIDER=ollama
AI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_CONCURRENCY=1
AI_TIMEOUT_SECONDS=180
AI_TEMPERATURE=0
AI_SEED=42
AI_NUM_CTX=8192
AI_NUM_PREDICT=1400
AI_MAX_RETRIES=1
